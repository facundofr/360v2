# Overrides que aplica `vite build` (mode=production).
# NO contiene secretos: sólo la URL pública de la API.
# Vite carga .env primero y este archivo lo pisa, así que un build de producción
# nunca sale apuntando al entorno de test aunque .env diga otra cosa.
VITE_API_BASE_URL=https://360.cober.online
