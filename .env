# ─── API ──────────────────────────────────────────────────────────────────────
# Producción: https://360.cober.online  (default si NO se define esta variable)
# Test:       https://wspflows.cober.online
VITE_API_BASE_URL=https://wspflows.cober.online

# ─── Firebase FCM ─────────────────────────────────────────────────────────────
# Sin estas variables NO funcionan las notificaciones push.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=

# ─── Asistente de Procedimientos ──────────────────────────────────────────────
# NO configurar acá. El asistente se consulta vía backend (POST /api/chatbot/mensaje),
# igual que en producción. Su API key debe vivir SÓLO en el backend: cualquier
# variable VITE_* se inlinea en el bundle y queda pública.
