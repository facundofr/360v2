# ─── API ──────────────────────────────────────────────────────────────────────
# Producción: https://360.cober.online  (default si NO se define esta variable)
# Test:       https://wspflows.cober.online
# Dejar sin definir para builds de producción.
VITE_API_BASE_URL=https://wspflows.cober.online

# ─── Firebase FCM ─────────────────────────────────────────────────────────────
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=

# ─── Asistente de Procedimientos ──────────────────────────────────────────────
